/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex, nofollow

# Remote content (v1.03). The manifest must never be cached anywhere: it is the
# pointer that tells the app a new release exists. The versioned files it points
# to have unique, never-changing URLs, so they are safe to cache for a year.
/content/manifest.json
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/content/vocab-*
  Cache-Control: public, max-age=31536000, immutable

/content/audio-index-*
  Cache-Control: public, max-age=31536000, immutable

# Root copies are the emergency offline fallback only.
/vocab.json
  Cache-Control: public, max-age=0, must-revalidate

/audio-index.json
  Cache-Control: public, max-age=0, must-revalidate

/audio/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: audio/mp4

/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
